# Copy to Distribution/config.env (git-ignored) and fill in. See docs/DISTRIBUTION.md.

# Your Apple Developer Team ID (10 characters): developer.apple.com → Membership details.
TEAM_ID=XXXXXXXXXX
BUNDLE_ID=com.xeratec.agenthud

# --- Direct download (Developer ID) -------------------------------------------------
# `security find-identity -v -p codesigning` lists these once the certificate is installed.
DEVELOPER_ID_APP="Developer ID Application: Xeratec (XXXXXXXXXX)"
# Created once with: xcrun notarytool store-credentials agenthud-notary --apple-id you@x.com --team-id XXXXXXXXXX
NOTARY_PROFILE=agenthud-notary

# --- Mac App Store and TestFlight ---------------------------------------------------
APPSTORE_APP_IDENTITY="Apple Distribution: Xeratec (XXXXXXXXXX)"
APPSTORE_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Xeratec (XXXXXXXXXX)"
# Mac App Store provisioning profile for BUNDLE_ID, downloaded from developer.apple.com.
APPSTORE_PROFILE=Distribution/AgentHUD_AppStore.provisionprofile
# App Store Connect API key (Users and Access → Integrations → App Store Connect API).
# Put the .p8 file at ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
